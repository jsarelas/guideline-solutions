<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for Azure App Service (Windows).
  The app picks its page from window.location.pathname (see src/App.tsx),
  so these paths must serve index.html instead of looking for a file.
  Keep this list in sync with the routes in src/App.tsx and src/seo.ts.
  Any other unknown path still returns a real 404.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="App pages" stopProcessing="true">
          <match url="^(founder|ceo|about|contact)/?$" ignoreCase="true" />
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
