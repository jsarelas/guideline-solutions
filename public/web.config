<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for Azure App Service (Windows).
  Each page is prerendered to its own HTML file at build time
  (scripts/prerender.mjs); these rules map the public URLs to those files.
  Keep this list in sync with scripts/prerender.mjs, src/App.tsx and src/seo.ts.
  Any other unknown path still returns a real 404.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- The default azurewebsites.net address would otherwise serve a duplicate copy of the site. -->
        <rule name="Canonical host" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^guideline-react\.azurewebsites\.net$" />
          </conditions>
          <action type="Redirect" url="https://www.guidelinesolutions.com/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Founder page" stopProcessing="true">
          <match url="^(founder|ceo|about)/?$" ignoreCase="true" />
          <action type="Rewrite" url="/founder.html" />
        </rule>
        <rule name="Contact page" stopProcessing="true">
          <match url="^contact/?$" ignoreCase="true" />
          <action type="Rewrite" url="/contact.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
